# Required
STUDIO_PASSWORD=          # the password you type to sign in
STUDIO_SECRET=            # long random text; encrypts tokens and signs your login
CRON_SECRET=              # long random text; the job runner URL needs it
APP_URL=                  # e.g. https://reach-studio.vercel.app (no trailing slash)
DATABASE_URL=             # Neon connection string (postgres://...). Leave empty locally to use ./data/pglite

# Claude (SEO)
ANTHROPIC_API_KEY=

# Video files: Cloudinary (free plan, no card). Dashboard → "API environment variable".
# Leave empty locally to use ./data/files
CLOUDINARY_URL=           # cloudinary://<api_key>:<api_secret>@<cloud_name>

# Or Cloudflare R2 instead of Cloudinary (needs a card or PayPal on file, no 100 MB limit)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# YouTube (Google Cloud OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook + Instagram (Meta app)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=           # optional, for Facebook Login for Business
META_GRAPH_VERSION=v23.0
