# You sign in with an email and password you create on the sign-in page. Supabase Auth keeps them.
STUDIO_SECRET=            # long random text; encrypts the platform tokens stored in the database
CRON_SECRET=              # long random text; the job runner and Claude helper send it, and it is the
                          # setup code for creating the first account in production
APP_URL=                  # e.g. https://reach-studio.vercel.app (no trailing slash)

# Supabase Auth (sign-in): Supabase dashboard → Connect. The publishable key is public, not a secret.
# NEXT_PUBLIC_ values are built into the app: after changing them on Vercel, redeploy.
NEXT_PUBLIC_SUPABASE_URL=                 # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Database: Supabase transaction pooler string (postgres://...:6543/postgres). The studio also reads and
# updates Supabase's auth.users through it (the studio_owner flag), so it is needed locally too.
SUPABASE_DATABASE_URL=

# Video files: Cloudinary (free plan, no card). Dashboard → "API environment variable".
# Real values go in .env.local (ignored by git) and in Vercel, never in this file.
# Leave empty locally to use ./data/files
CLOUDINARY_URL=           # cloudinary://<api_key>:<api_secret>@<cloud_name>

# YouTube (Google Cloud OAuth client, type "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook + Instagram (Meta app)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=           # optional, for Facebook Login for Business
META_GRAPH_VERSION=v23.0

# Claude helper on your laptop (npm run claude-helper). Claude itself uses your Claude account login.
HELPER_STUDIO_URL=        # the deployed studio, e.g. https://reach-studio.vercel.app (default: APP_URL)
HELPER_SECRET=            # the deployed studio's CRON_SECRET (default: CRON_SECRET)

# Starts Claude on GitHub right after an upload, instead of waiting for GitHub's late schedule.
# GitHub → Settings → Developer settings → Fine-grained tokens: only this repository, "Actions: Read and write".
GITHUB_ACTIONS_TOKEN=
GITHUB_REPO=              # owner/name; Vercel fills it in from the connected repository
