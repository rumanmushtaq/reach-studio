# Sign-in: you sign in with Google. Only these Google accounts can open the studio (comma separated).
OWNER_EMAILS=             # e.g. you@gmail.com
STUDIO_SECRET=            # long random text; encrypts tokens and signs your login (not a password you type)
CRON_SECRET=              # long random text; the job runner and the Claude helper send it
APP_URL=                  # e.g. https://reach-studio.vercel.app (no trailing slash)

# Database: Supabase transaction pooler string (postgres://...:6543/postgres). Leave empty locally to use ./data/pglite
SUPABASE_DATABASE_URL=

# Video files: Cloudinary (free plan, no card). Dashboard → "API environment variable".
# Leave empty locally to use ./data/files
CLOUDINARY_URL=           # cloudinary://<api_key>:<api_secret>@<cloud_name>

# Google Cloud OAuth client, type "Web application": signs you in and connects YouTube
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook + Instagram (Meta app)
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=           # optional, for Facebook Login for Business
META_GRAPH_VERSION=v23.0

# Claude helper on your laptop (npm run claude-helper). Claude itself uses your Claude account login.
HELPER_STUDIO_URL=        # the deployed studio, e.g. https://reach-studio.vercel.app (default: APP_URL)
HELPER_SECRET=            # the deployed studio's CRON_SECRET (default: CRON_SECRET)
