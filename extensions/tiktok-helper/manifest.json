{
  "manifest_version": 3,
  "name": "Reach Studio TikTok helper",
  "version": "1.2.0",
  "description": "Saves your Reach Studio video for TikTok's upload page and fills Claude's caption after you pick it. You press Post.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://reach-studio-five.vercel.app/*",
        "http://localhost:3100/*"
      ],
      "js": [
        "studio.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tiktok.com/tiktokstudio/upload*",
        "https://www.tiktok.com/creator-center/upload*",
        "https://www.tiktok.com/upload*"
      ],
      "js": [
        "fill.js",
        "tiktok.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
