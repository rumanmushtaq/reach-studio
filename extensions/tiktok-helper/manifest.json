{
  "manifest_version": 3,
  "name": "Reach Studio posting helper",
  "version": "1.6.0",
  "description": "Posts Reach Studio videos where no app may: saves the video for TikTok or Facebook, fills Claude's caption after you pick it, and sets TikTok's schedule. You press Post.",
  "permissions": [
    "storage",
    "downloads"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://reach-studio-five.vercel.app/*",
        "http://localhost:3100/*"
      ],
      "js": [
        "studio.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.tiktok.com/tiktokstudio/upload*",
        "https://www.tiktok.com/creator-center/upload*",
        "https://www.tiktok.com/upload*",
        "https://www.facebook.com/reels/create*",
        "https://web.facebook.com/reels/create*"
      ],
      "js": [
        "fill.js",
        "site.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
